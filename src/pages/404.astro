---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found - start.blueteam.id">
  <div class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__heading">Page not found</h1>
    <p class="not-found__body">
      This page doesn't exist, or it moved. Try the tracks catalog, or head back home.
    </p>
    <div class="not-found__ctas">
      <a class="not-found__cta not-found__cta--primary" href="/">Go home</a>
      <a class="not-found__cta not-found__cta--secondary" href="/tracks/">Browse tracks</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: 32rem;
    margin: 0 auto;
    padding: 4rem 1.25rem;
    text-align: center;
  }

  .not-found__code {
    margin: 0;
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--blue);
  }

  .not-found__heading {
    margin: 0.5rem 0 1rem;
    font-size: 1.5rem;
    color: var(--text);
  }

  .not-found__body {
    margin: 0 0 2rem;
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.5;
  }

  .not-found__ctas {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .not-found__cta {
    display: inline-block;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .not-found__cta--primary {
    background: var(--blue);
    color: var(--bg);
  }

  .not-found__cta--primary:hover,
  .not-found__cta--primary:focus-visible {
    filter: brightness(1.1);
  }

  .not-found__cta--secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .not-found__cta--secondary:hover,
  .not-found__cta--secondary:focus-visible {
    border-color: var(--blue);
  }
</style>
