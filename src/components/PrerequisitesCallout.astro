---
// Small callout shown on a lesson page only when the lesson's frontmatter
// sets `prerequisites`. LessonView decides whether to render this at all;
// this component just displays the given text.
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="prerequisites-callout" role="note" data-prerequisites-callout>
  <p class="prerequisites-callout__label">Prerequisites</p>
  <p class="prerequisites-callout__text">{text}</p>
</div>

<style>
  .prerequisites-callout {
    border: 1px solid var(--border);
    border-left: 3px solid var(--blue);
    background: var(--bg-card);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
    margin-bottom: 1.5rem;
  }

  .prerequisites-callout__label {
    margin: 0 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .prerequisites-callout__text {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text);
  }
</style>
