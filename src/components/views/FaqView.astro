<div class="faq">
  <h1 class="faq__heading">FAQ</h1>
  <p class="faq__placeholder">FAQ content coming soon, ask in Discord in the meantime.</p>
</div>

<style>
  .faq {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .faq__heading {
    margin: 0 0 1rem;
    font-size: 1.75rem;
    color: var(--text);
  }

  .faq__placeholder {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  @media (max-width: 480px) {
    .faq {
      padding: 1.5rem 1rem 3rem;
    }

    .faq__heading {
      font-size: 1.4rem;
    }
  }
</style>
