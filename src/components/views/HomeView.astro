---
import { CATALOG_TRACKS } from '../../data/catalog';
import TrackCard from '../TrackCard.astro';
import DiscordBand from '../DiscordBand.astro';

const liveTracks = CATALOG_TRACKS.filter((track) => track.status === 'live');

const pillars = [
  {
    icon: '🛠️',
    title: 'Hands-on by default',
    body: 'Most lessons end with a real, small task on your own machine, not just reading.',
  },
  {
    icon: '🧭',
    title: 'Pick your own path',
    body: 'Tracks are independent. Start wherever matches what you want to learn next.',
  },
  {
    icon: '🤝',
    title: 'Built by the community',
    body: 'Written and reviewed by blueteam.id volunteers, human-made with AI help.',
  },
  {
    icon: '🚫',
    title: 'No upsell ever',
    body: 'No paid tiers, no "unlock more," nothing to buy, ever.',
  },
];
---

<div class="home">
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <span class="hero__badge">100% free, no sign-up, community-run</span>
        <h1 class="hero__headline">Learn the foundations of blue team security, for free.</h1>
        <p class="hero__sub">
          A set of guided tracks covering how computers, operating systems, networks and the web
          actually work, the groundwork every defender needs before anything else.
        </p>
        <div class="hero__ctas">
          <a class="hero__cta hero__cta--primary" href="/tracks/">Browse tracks</a>
          <a class="hero__cta hero__cta--secondary" href="/contributing/">What's this about?</a>
        </div>
      </div>
      <div class="hero__visual" aria-hidden="true">
        <div class="hero__radar">
          <div class="hero__radar-rings"></div>
          <div class="hero__radar-sweep"></div>
          <span class="hero__radar-blip hero__radar-blip--1"></span>
          <span class="hero__radar-blip hero__radar-blip--2"></span>
          <span class="hero__radar-blip hero__radar-blip--3"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="pillars">
    <div class="pillars__grid">
      {pillars.map((pillar) => (
        <div class="pillar">
          <div class="pillar__icon" aria-hidden="true">{pillar.icon}</div>
          <h3 class="pillar__title">{pillar.title}</h3>
          <p class="pillar__body">{pillar.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="tracks-teaser">
    <div class="tracks-teaser__head">
      <h2 class="tracks-teaser__heading">Start learning</h2>
      <a class="tracks-teaser__see-all" href="/tracks/">See all tracks</a>
    </div>
    <div class="tracks-teaser__grid">
      {liveTracks.map((track) => (
        <TrackCard track={track} />
      ))}
    </div>
  </section>

  <section class="home__discord">
    <DiscordBand
      heading="Questions, feedback, or want to help build the next track?"
      body="Join the community Discord, this project is built in the open by volunteers."
    />
  </section>
</div>

<style>
  .home {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .hero {
    padding: 3rem 0 1rem;
  }

  .hero__inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .hero__copy {
    flex: 1 1 24rem;
    min-width: 0;
  }

  .hero__badge {
    display: inline-block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--green);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.25rem;
  }

  .hero__headline {
    margin: 0 0 1rem;
    font-size: 2.25rem;
    line-height: 1.15;
    color: var(--text);
  }

  .hero__sub {
    margin: 0 0 1.5rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--text-dim);
    max-width: 38rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .hero__cta {
    display: inline-block;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .hero__cta--primary {
    background: var(--blue);
    color: var(--bg);
  }

  .hero__cta--primary:hover,
  .hero__cta--primary:focus-visible {
    filter: brightness(1.1);
  }

  .hero__cta--secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .hero__cta--secondary:hover,
  .hero__cta--secondary:focus-visible {
    border-color: var(--blue);
  }

  .hero__visual {
    flex: 1 1 18rem;
    max-width: 22rem;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .hero__radar {
    position: relative;
    width: 78%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    overflow: hidden;
  }

  .hero__radar-rings {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-image: repeating-radial-gradient(
      circle,
      var(--border) 0,
      var(--border) 1px,
      transparent 1px,
      transparent 18%
    );
    opacity: 0.8;
  }

  .hero__radar-sweep {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0deg, var(--green) 10deg, transparent 70deg, transparent 360deg);
    opacity: 0.6;
    animation: radar-spin 4.5s linear infinite;
  }

  .hero__radar-blip {
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
  }

  .hero__radar-blip::before,
  .hero__radar-blip::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .hero__radar-blip::before {
    background: var(--green);
  }

  .hero__radar-blip::after {
    border: 1px solid var(--green);
    animation: radar-ping 2.6s ease-out infinite;
  }

  .hero__radar-blip--1 {
    top: 20%;
    left: 60%;
  }

  .hero__radar-blip--2 {
    top: 58%;
    left: 24%;
  }

  .hero__radar-blip--2::before {
    background: var(--yellow);
  }

  .hero__radar-blip--2::after {
    border-color: var(--yellow);
    animation-delay: 0.9s;
  }

  .hero__radar-blip--3 {
    top: 70%;
    left: 66%;
  }

  .hero__radar-blip--3::after {
    animation-delay: 1.8s;
  }

  @keyframes radar-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes radar-ping {
    0% {
      transform: scale(1);
      opacity: 0.9;
    }
    100% {
      transform: scale(4.5);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__radar-sweep,
    .hero__radar-blip::after {
      animation: none;
    }
  }

  .pillars__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .pillar {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }

  .pillar__icon {
    font-size: 1.5rem;
    margin-bottom: 0.6rem;
  }

  .pillar__title {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    color: var(--text);
  }

  .pillar__body {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--text-dim);
  }

  .tracks-teaser__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .tracks-teaser__heading {
    margin: 0;
    font-size: 1.5rem;
    color: var(--text);
  }

  .tracks-teaser__see-all {
    color: var(--blue);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .tracks-teaser__see-all:hover,
  .tracks-teaser__see-all:focus-visible {
    text-decoration: underline;
  }

  .tracks-teaser__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 720px) {
    .pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .home {
      padding: 0 1rem 3rem;
      gap: 2.25rem;
    }

    .hero {
      padding: 2rem 0 0.5rem;
    }

    .hero__headline {
      font-size: 1.6rem;
    }

    .hero__sub {
      font-size: 0.95rem;
    }

    .pillars__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
