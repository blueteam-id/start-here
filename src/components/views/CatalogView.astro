---
// Full catalog page content: heading, a search input, category filter
// chips, and the category-grouped track listing. The listing itself is
// always fully server-rendered (every track, every category, in the fixed
// category order from CATALOG_CATEGORIES); the search box and filter chips
// are a vanilla-JS progressive enhancement on top of that static markup
// (see the <script> below), so the page works with JS disabled.
import { CATALOG_TRACKS, groupByCategory } from '../../data/catalog';
import CategoryGroup from '../CategoryGroup.astro';

const groups = groupByCategory(CATALOG_TRACKS);
const categories = groups.map((group) => group.category);
const trackCount = CATALOG_TRACKS.length;
const categoryCount = categories.length;
const liveCount = CATALOG_TRACKS.filter((track) => track.status === 'live').length;
---

<div class="catalog" data-catalog>
  <div class="catalog__intro">
    <h1 class="catalog__heading">All Tracks</h1>
    <p class="catalog__subheading">
      {trackCount} tracks, {categoryCount} categories. {liveCount} live so far; the rest are
      coming soon.
    </p>
  </div>

  <div class="catalog__controls">
    <input
      type="search"
      class="catalog__search"
      placeholder="Search tracks"
      aria-label="Search tracks"
      data-catalog-search
    />
    <div class="catalog__chips" role="group" aria-label="Filter by category">
      <button type="button" class="catalog__chip" data-catalog-chip="all" aria-pressed="true">
        All
      </button>
      {categories.map((category) => (
        <button type="button" class="catalog__chip" data-catalog-chip={category} aria-pressed="false">
          {category}
        </button>
      ))}
    </div>
  </div>

  <div class="catalog__groups" data-catalog-groups>
    {groups.map((group) => (
      <div data-catalog-category={group.category}>
        <CategoryGroup category={group.category} tracks={group.tracks} />
      </div>
    ))}
  </div>

  <p class="catalog__empty" data-catalog-empty hidden>No tracks match your search.</p>
</div>

<script>
  import { wireCatalogFilter } from '../../scripts/catalogFilter.client';

  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((root) => {
    wireCatalogFilter(root);
  });
</script>

<style>
  .catalog {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .catalog__intro {
    margin-bottom: 1.5rem;
  }

  .catalog__heading {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    color: var(--text);
  }

  .catalog__subheading {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .catalog__controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .catalog__search {
    width: 100%;
    box-sizing: border-box;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.65rem 0.9rem;
    color: var(--text);
    font-size: 0.95rem;
  }

  .catalog__search::placeholder {
    color: var(--text-dim);
  }

  .catalog__search:focus-visible {
    outline: none;
    border-color: var(--blue);
  }

  .catalog__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .catalog__chip {
    appearance: none;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-dim);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    cursor: pointer;
  }

  .catalog__chip:hover,
  .catalog__chip:focus-visible {
    color: var(--text);
  }

  .catalog__chip[aria-pressed='true'] {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--bg);
  }

  .catalog__empty {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  @media (max-width: 480px) {
    .catalog {
      padding: 1.5rem 1rem 3rem;
    }

    .catalog__heading {
      font-size: 1.4rem;
    }
  }
</style>
