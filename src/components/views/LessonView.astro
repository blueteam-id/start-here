---
// Full lesson page content: sidebar + breadcrumb + optional prerequisites
// callout + the lesson's rendered MDX body + optional Reflect/Go further
// sections + a mark-complete footer with a next-lesson link. The lesson
// body itself is always fully server-rendered (via the `Content` component
// the caller passes in from `render(lesson)`); the mark-complete button is
// a vanilla-JS progressive enhancement on top of that static markup (see
// the <script> below), reading/writing progress through src/lib/progress.ts.
import type { LessonEntry, TrackEntry } from '../../lib/collections';
import LessonSidebar from '../LessonSidebar.astro';
import PrerequisitesCallout from '../PrerequisitesCallout.astro';
import ReflectSection from '../ReflectSection.astro';
import GoFurtherSection from '../GoFurtherSection.astro';
import { getProgress } from '../../lib/progress';
import { DISCORD_INVITE_URL } from '../../lib/site';
import { reportEmailUrl, reportIssueUrl } from '../../lib/report';
// Imported and rendered (hidden, below) purely so Astro registers
// CodeTabs.astro's scoped CSS for this page. Astro only adds a component's
// styles to a page's stylesheet when that component's render() actually
// executes within the page's own render pass; lesson bodies render
// through the dynamic `Content` component from `render(lesson)` on an MDX
// collection entry, and a `<CodeTabs>` used only inside that MDX body
// doesn't register its styles that way, even though it renders correctly
// into the page's HTML. A hidden, empty render here is the workaround.
import CodeTabs from '../CodeTabs.astro';

interface Props {
  track: TrackEntry;
  lessons: LessonEntry[];
  lesson: LessonEntry;
  Content: any;
  reflectQuestions?: string[];
  resources?: Array<{ label: string; url: string }>;
}

const { track, lessons, lesson, Content, reflectQuestions = [], resources = [] } = Astro.props;

// The collection slug is "<trackSlug>/<lessonSlug>"; strip the track prefix
// to get the short slug used for routing and for progress keys.
function shortSlug(entry: LessonEntry): string {
  return entry.slug.split('/').slice(1).join('/');
}

const orderedLessons = [...lessons].sort((a, b) => a.data.order - b.data.order);
const currentSlug = shortSlug(lesson);

const sidebarLessons = orderedLessons.map((entry) => ({
  slug: shortSlug(entry),
  title: entry.data.title,
  phase: entry.data.phase,
}));

// Progress is read at render time via the real progress module. During the
// static build this always comes back empty (no localStorage on the
// server, and this is a fully static site with no server output) --
// wireMarkComplete re-reads real progress client-side on load and updates
// the sidebar's checkmarks and progress bar to match (see the <script>
// below and src/scripts/markComplete.client.ts).
const progress = getProgress(track.slug);

const currentIndex = orderedLessons.findIndex((entry) => entry.slug === lesson.slug);
const nextLesson = currentIndex >= 0 ? orderedLessons[currentIndex + 1] : undefined;
const prevLesson = currentIndex > 0 ? orderedLessons[currentIndex - 1] : undefined;
const trackHref = `/tracks/${track.slug}/`;
const nextHref = nextLesson ? `/tracks/${track.slug}/${shortSlug(nextLesson)}/` : undefined;
const prevHref = prevLesson ? `/tracks/${track.slug}/${shortSlug(prevLesson)}/` : undefined;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const reportContext = { trackTitle: track.data.title, lessonTitle: lesson.data.title, pageUrl };
const reportIssueHref = reportIssueUrl(reportContext);
const reportEmailHref = reportEmailUrl(reportContext);

// `Content` is normally a real Astro component factory produced by
// `render(lesson)` (and must be rendered via `<Content />` so Astro wires
// up its own result/slot context). Tests exercise this component directly
// with a plain stand-in function instead, which `<Content />` can't render
// (Astro treats a bare function as a UI-framework component and throws
// without a renderer installed) -- so fall back to calling it directly and
// inserting its returned markup for anything that isn't a real factory.
const ContentIsAstroFactory = typeof Content === 'function' && (Content as any).isAstroComponentFactory === true;
---

<div class="lesson-view" data-lesson-view data-track-slug={track.slug} data-lesson-slug={currentSlug}>
  <a class="skip-link" href="#lesson-content">Skip to lesson</a>
  <LessonSidebar
    trackTitle={track.data.title}
    trackSlug={track.slug}
    lessons={sidebarLessons}
    currentSlug={currentSlug}
    progress={progress}
  />

  <div class="lesson-view__main" id="lesson-content" tabindex="-1">
    <nav class="lesson-view__breadcrumb" aria-label="Breadcrumb">
      <a href={trackHref}>{track.data.title}</a>
      <span aria-hidden="true">/</span>
      <span>{lesson.data.title}</span>
    </nav>

    <div class="lesson-view__title-block">
      <span class="lesson-view__phase-tag">{lesson.data.phase}</span>
      <h1 class="lesson-view__title">{lesson.data.title}</h1>
      <div class="lesson-view__title-meta">
        {lesson.data.estimatedMinutes != null && <span>{lesson.data.estimatedMinutes} min</span>}
        {lesson.data.needsVM && <span class="lesson-view__vm-badge">Needs a VM</span>}
      </div>
    </div>

    {lesson.data.prerequisites && <PrerequisitesCallout text={lesson.data.prerequisites} />}

    <article class="lesson-view__content" data-lesson-content>
      {ContentIsAstroFactory ? <Content /> : <Fragment set:html={Content()} />}
      <div style="display:none" aria-hidden="true"><CodeTabs /></div>
    </article>

    <div class="lesson-view__discord-nudge" role="note">
      Stuck, or just want to talk it through? Ask in the{' '}
      <a href={DISCORD_INVITE_URL} target="_blank" rel="noopener noreferrer">Discord</a>,
      no need to get stuck here alone.
    </div>

    <ReflectSection questions={reflectQuestions} />
    <GoFurtherSection resources={resources} />

    <p class="lesson-view__report">
      Spotted a mistake, or a command that did not work for you?{' '}
      <a href={reportIssueHref} target="_blank" rel="noopener noreferrer" data-report-issue>Report it on GitHub</a>{' '}
      or <a href={reportEmailHref} data-report-email>by email</a>.
    </p>

    <footer class="lesson-view__footer">
      <div class="lesson-view__footer-side">
        {prevHref && (
          <a class="lesson-view__prev" href={prevHref} rel="prev">
            <span aria-hidden="true">← </span>Previous lesson
          </a>
        )}
      </div>
      <button type="button" class="lesson-view__mark-complete" data-mark-complete aria-pressed="false">
        Mark complete
      </button>
      <div class="lesson-view__footer-side lesson-view__footer-side--end">
        {nextHref ? (
          <a class="lesson-view__next" href={nextHref} rel="next">
            Next lesson<span aria-hidden="true"> →</span>
          </a>
        ) : (
          <a class="lesson-view__next" href={trackHref}>Back to track</a>
        )}
      </div>
    </footer>
  </div>
</div>

<script>
  import { wireMarkComplete } from '../../scripts/markComplete.client';
  import { wireCopyButtons } from '../../scripts/copyCode.client';

  document.querySelectorAll<HTMLElement>('[data-lesson-view]').forEach((root) => {
    const trackSlug = root.getAttribute('data-track-slug');
    const lessonSlug = root.getAttribute('data-lesson-slug');
    if (trackSlug && lessonSlug) {
      wireMarkComplete(root, trackSlug, lessonSlug);
    }
    const content = root.querySelector<HTMLElement>('[data-lesson-content]');
    if (content) wireCopyButtons(content);
  });
</script>

<style>
  .lesson-view {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: 2rem;
    align-items: start;
  }

  .lesson-view__main {
    min-width: 0;
  }

  .lesson-view__breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }

  .lesson-view__breadcrumb a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .lesson-view__breadcrumb a:hover,
  .lesson-view__breadcrumb a:focus-visible {
    color: var(--text);
  }

  .lesson-view__content {
    color: var(--text);
    line-height: 1.65;
  }

  .lesson-view__title-block {
    margin-bottom: 1.5rem;
  }

  .lesson-view__phase-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
    border: 1px solid var(--blue);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.6rem;
  }

  .lesson-view__title {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--text);
  }

  .lesson-view__title-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .lesson-view__vm-badge {
    color: var(--yellow);
  }

  .lesson-view__discord-nudge {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--green);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    margin: 1.75rem 0;
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  .lesson-view__discord-nudge a {
    color: var(--blue);
    font-weight: 600;
    text-decoration: none;
  }

  .lesson-view__discord-nudge a:hover,
  .lesson-view__discord-nudge a:focus-visible {
    text-decoration: underline;
  }

  .lesson-view__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .lesson-view__mark-complete {
    appearance: none;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--text);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.6rem 1.1rem;
    cursor: pointer;
  }

  .lesson-view__mark-complete[aria-pressed='true'] {
    background: var(--blue);
    border-color: var(--blue);
    color: var(--bg);
  }

  .lesson-view__mark-complete:hover,
  .lesson-view__mark-complete:focus-visible {
    opacity: 0.9;
  }

  .lesson-view__footer-side {
    flex: 1 1 0;
    min-width: 8rem;
  }

  .lesson-view__footer-side--end {
    text-align: right;
  }

  .lesson-view__main:focus {
    outline: none;
  }

  .lesson-view__report {
    margin: 1.75rem 0 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .lesson-view__report a {
    color: var(--blue);
    text-decoration: none;
  }

  .lesson-view__report a:hover,
  .lesson-view__report a:focus-visible {
    text-decoration: underline;
  }

  .lesson-view__prev,
  .lesson-view__next {
    color: var(--blue);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .lesson-view__prev:hover,
  .lesson-view__prev:focus-visible,
  .lesson-view__next:hover,
  .lesson-view__next:focus-visible {
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .lesson-view {
      grid-template-columns: 1fr;
      padding: 1.5rem 1rem 3rem;
      gap: 1.25rem;
    }

    /* Phone: full-width "Mark complete" on top, previous/next side by side. */
    .lesson-view__footer {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .lesson-view__mark-complete {
      grid-column: 1 / -1;
      order: -1;
    }

    .lesson-view__footer-side {
      min-width: 0;
    }
  }
</style>

<style is:global>
  /* Copy buttons are added by copyCode.client.ts after render, so these
     styles must be global: Astro's scoped styles never reach them. */
  .code-block {
    position: relative;
  }

  .code-block__copy {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    appearance: none;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 0.35rem;
    color: var(--text-dim);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    cursor: pointer;
    opacity: 0.85;
  }

  .code-block__copy:hover,
  .code-block__copy:focus-visible {
    color: var(--text);
    opacity: 1;
  }

  /* Lesson code blocks get breathing room; Shiki's default has none. */
  .lesson-view__content pre {
    padding: 0.75rem 0.9rem;
    border-radius: 0.4rem;
  }

  /* Leave room so the button never covers the end of the first line. */
  .lesson-view__content .code-block pre {
    padding-right: 4.75rem;
  }
</style>
